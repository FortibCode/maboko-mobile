<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecran de lancement natif, affiche avant que Flutter ne demarre.

    Il montrait un fond blanc vide : l'application semblait mettre du temps a
    s'ouvrir sur rien. Le symbole Maboko sur le creme de la charte enchaine
    sans rupture avec le premier ecran de l'application.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
